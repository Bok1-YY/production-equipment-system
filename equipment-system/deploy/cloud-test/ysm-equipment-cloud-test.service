[Unit]
Description=优胜美设备管理云端验证服务
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ecs-user
Group=ecs-user
WorkingDirectory=/home/ecs-user/ysm-app
Environment=NODE_ENV=cloud-test
Environment=HOST=0.0.0.0
Environment=PORT=8788
Environment=YSM_DB_PATH=/home/ecs-user/ysm-data/equipment.db
EnvironmentFile=/etc/ysm-equipment-cloud-test.env
ExecStart=/usr/local/bin/node /home/ecs-user/ysm-app/src/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/ecs-user/ysm-data

[Install]
WantedBy=multi-user.target
